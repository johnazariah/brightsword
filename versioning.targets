<Project>
  <!-- 
    Version bump target for the BrightSword suite.
    Usage: dotnet msbuild Build.proj /t:IncrementVersion /p:Level=Patch
           dotnet msbuild Build.proj /t:IncrementVersion /p:Level=Minor
           dotnet msbuild Build.proj /t:IncrementVersion /p:Level=Major
    Add /p:Commit=true to git-commit the change.
  -->

  <Target Name="IncrementVersion">
    <PropertyGroup>
      <_VersionFile>$(MSBuildThisFileDirectory)version.props</_VersionFile>
      <_Level Condition="'$(Level)' == ''">Patch</_Level>
      <_Level Condition="'$(Level)' != ''">$(Level)</_Level>
      <_Script>$(MSBuildThisFileDirectory)scripts\increment-version.ps1</_Script>
    </PropertyGroup>

    <Exec Command="pwsh -NoProfile -NonInteractive -File &quot;$(_Script)&quot; -VersionFile &quot;$(_VersionFile)&quot; -Level $(_Level)"
          WorkingDirectory="$(MSBuildThisFileDirectory)" />

    <Exec Command="git add version.props" WorkingDirectory="$(MSBuildThisFileDirectory)" Condition="'$(Commit)' == 'true'" />
    <Exec Command="git commit -m &quot;Bump suite version&quot; version.props" WorkingDirectory="$(MSBuildThisFileDirectory)" Condition="'$(Commit)' == 'true'" />
  </Target>
</Project>